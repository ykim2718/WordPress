{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "key-word-cloud/word-cloud",
	"title": "Key Word Cloud",
	"category": "yrocket",
	"icon": "cloud",
	"description": "Draws the uploaded topics as a word cloud. Leave a field empty to use the saved setting.",
	"keywords": ["word", "cloud", "topic", "keyword", "단어"],
	"textdomain": "key-word-cloud",
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	},
	"attributes": {
		"language": { "type": "string", "default": "" },
		"shape": { "type": "string", "default": "" },
		"color_mode": { "type": "string", "default": "" },
		"max": { "type": "string", "default": "" },
		"min_posts": { "type": "string", "default": "" },
		"min_size": { "type": "string", "default": "" },
		"max_size": { "type": "string", "default": "" },
		"color_start": { "type": "string", "default": "" },
		"color_end": { "type": "string", "default": "" },
		"link": { "type": "string", "default": "" },
		"cache": { "type": "string", "default": "" }
	},
	"editorScript": "file:./editor.js"
}
